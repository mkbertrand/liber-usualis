{# Icons from Phosphor Icons (https://phosphoricons.com), MIT License; light weight, except the menu buttons' regular weight #}
{# Each language in its own language, so it is recognisable whatever the current locale #}
{% set locale_names = {'de': 'Deutsch', 'en': 'English', 'la': 'Latina', 'nl': 'Nederlands'} %}
{% set path_without_locale = canonical_path[(locale|length) + 1:] %}
<div id="top-bar-title">
  <div id="top-bar-left-aligned-container">
    <div id="project-logo">
      <div id="logo-link-wrapper"><a id="logo-link" href="/{{ locale }}/index"><img id="logo" src="/resources/agnus-dei.webp" alt="LIBER USUALIS"></a></div>
    </div>
  </div>
  {# On narrow screens this becomes a dropdown opened by the menu button below #}
  <div id="top-bar-menu">
    <nav id="top-bar-navigation">
      <a class="navigation-link" href="/{{ locale }}/pray">{{ top_bar_text['pray'] }}</a>
      <a class="navigation-link" href="/{{ locale }}/de-anno">{{ top_bar_text['de-anno'] }}</a>
      <a class="navigation-link" href="/{{ locale }}/rubricae">{{ top_bar_text['rubricae'] }}</a>
      <a class="navigation-link" href="/{{ locale }}/kalendar">{{ top_bar_text['kalendar'] }}</a>
      <a class="navigation-link" href="/{{ locale }}/ordo">{{ top_bar_text['ordo'] }}</a>
      <a class="navigation-link" href="/{{ locale }}/about">{{ top_bar_text['about'] }}</a>
      <a class="navigation-link" href="/{{ locale }}/resources">{{ top_bar_text['resources'] }}</a>
    </nav>
    <div id="top-bar-right-aligned-container">
      <div class="top-bar-button-container">
        <a id="donate-button" class="ui-button ui-button-primary" href="/{{ locale }}/donate">{{ top_bar_text['donate'] }}</a>
      </div>
    </div>
  </div>
  <button id="top-bar-menu-button" class="ui-button icon-button ui-button-secondary" type="button" aria-label="{{ top_bar_text['menu-button'] }}" aria-expanded="false" aria-controls="top-bar-menu">
    <svg class="icon" width="24" height="24" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M224,128a8,8,0,0,1-8,8H40a8,8,0,0,1,0-16H216A8,8,0,0,1,224,128ZM40,72H216a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16ZM216,184H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Z"/></svg>
  </button>
  {# Secondary actions, kept out of the way: feedback, theme, and language #}
  <div id="more-menu-container">
    <button id="more-menu-button" class="ui-button icon-button ui-button-secondary" type="button" aria-label="{{ top_bar_text['more-menu-button'] }}" aria-haspopup="true" aria-expanded="false" aria-controls="more-menu">
      <svg class="icon" width="24" height="24" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" fill="currentColor"><path d="M140,128a12,12,0,1,1-12-12A12,12,0,0,1,140,128ZM128,72a12,12,0,1,0-12-12A12,12,0,0,0,128,72Zm0,112a12,12,0,1,0,12,12A12,12,0,0,0,128,184Z"/></svg>
    </button>
    <div id="more-menu" hidden>
      <a class="more-menu-item" href="mailto:admin@liberusualis.org">{{ top_bar_text['feedback-link'] }}</a>
      {# Shows whether the dark theme is on; CSS hides the other state #}
      <button id="dark-mode-toggle" class="more-menu-item" type="button">
        {{ top_bar_text['dark-theme-label'] }}: <span class="dark-mode-toggle-on-label">{{ top_bar_text['dark-theme-on'] }}</span><span class="dark-mode-toggle-off-label">{{ top_bar_text['dark-theme-off'] }}</span>
      </button>
      {# Opens the languages as a second menu, beside this one #}
      <div id="locale-selector">
        <button id="locale-selector-button" class="more-menu-item" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="locale-menu">{{ top_bar_text['locale-selector-label'] }}: {{ locale_names.get(locale, locale.upper()) }}</button>
        <div id="locale-menu" hidden>
          {% for loc in DEFINED_LOCALES|sort %}
          <a class="more-menu-item locale-menu-option" href="/{{ loc }}{{ path_without_locale }}" lang="{{ loc }}" hreflang="{{ loc }}" data-locale="{{ loc }}"{% if loc == locale %} aria-current="true"{% endif %}>{{ locale_names.get(loc, loc.upper()) }}</a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  (function() {
    const bar = document.getElementById('top-bar-title');
    const button = document.getElementById('top-bar-menu-button');
    const menu = document.getElementById('top-bar-menu');
    function setOpen(open) {
      bar.classList.toggle('top-bar-menu-open', open);
      button.setAttribute('aria-expanded', open);
    }
    button.addEventListener('click', () => setOpen(!bar.classList.contains('top-bar-menu-open')));
    document.addEventListener('click', (event) => {
      if (bar.classList.contains('top-bar-menu-open') && !menu.contains(event.target) && !button.contains(event.target)) {
        setOpen(false);
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key == 'Escape' && bar.classList.contains('top-bar-menu-open')) {
        setOpen(false);
        button.focus();
      }
    });
  })();
  (function() {
    const button = document.getElementById('more-menu-button');
    const menu = document.getElementById('more-menu');
    const localeButton = document.getElementById('locale-selector-button');
    const localeMenu = document.getElementById('locale-menu');
    function setLocaleMenuOpen(open) {
      localeMenu.hidden = !open;
      localeButton.setAttribute('aria-expanded', open);
    }
    function setOpen(open) {
      menu.hidden = !open;
      button.setAttribute('aria-expanded', open);
      if (!open) setLocaleMenuOpen(false);
    }
    button.addEventListener('click', () => setOpen(menu.hidden));
    localeButton.addEventListener('click', () => setLocaleMenuOpen(localeMenu.hidden));
    // The pray page changes its path without reloading, so the server-rendered link may be stale; reopen the
    // current path (which starts with /{locale}/) in the chosen locale instead
    localeMenu.addEventListener('click', (event) => {
      const option = event.target.closest('[data-locale]');
      if (!option || event.ctrlKey || event.metaKey || event.shiftKey || event.button != 0) return;
      event.preventDefault();
      window.location.assign('/' + option.dataset.locale + window.location.pathname.slice({{ (locale|length) + 1 }}) + window.location.search);
    });
    document.addEventListener('click', (event) => {
      if (!menu.hidden && !menu.contains(event.target) && !button.contains(event.target)) {
        setOpen(false);
      }
    });
    // Escape closes the language menu first, then the main one
    document.addEventListener('keydown', (event) => {
      if (event.key != 'Escape' || menu.hidden) return;
      if (!localeMenu.hidden) {
        setLocaleMenuOpen(false);
        localeButton.focus();
      } else {
        setOpen(false);
        button.focus();
      }
    });
  })();
</script>
{# The pray page sets bars-collapsed itself (pray-view.js), together with its bottom bar and panels #}
{% if not page_collapses_top_bar %}
<script>
  // On narrow screens, while the reader scrolls down, the top bar shrinks (see top-bar.css); any upward scroll restores
  // it. It stays at full size near the top of the page and while one of its menus is open.
  (function() {
    const bar = document.getElementById('top-bar-title');
    const moreMenu = document.getElementById('more-menu');
    let lastScrollY = Math.max(0, window.scrollY);
    window.addEventListener('scroll', () => {
      // Clamped, so the rubber-band overscroll of touch browsers doesn't read as a change of direction
      const maxScrollY = document.documentElement.scrollHeight - window.innerHeight;
      const scrollY = Math.min(Math.max(0, window.scrollY), maxScrollY);
      const menuOpen = bar.classList.contains('top-bar-menu-open') || !moreMenu.hidden;
      if (menuOpen || scrollY < lastScrollY) {
        document.body.classList.remove('bars-collapsed');
      } else if (scrollY > lastScrollY && scrollY > bar.offsetHeight) {
        document.body.classList.add('bars-collapsed');
      }
      lastScrollY = scrollY;
    }, {passive: true});
  })();
</script>
{% endif %}
